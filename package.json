{
  "name": "inkflow",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "start": "electron-vite preview",
    "dev": "concurrently \"electron-vite dev\" \"yarn start:server\"",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:win": "yarn build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "start:server": "tsx src/database/ollamaService.ts",
    "test": "yarn unitTest && playwright test && yarn electronTest",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "unitTest": "jest",
    "electronTest": "electron-mocha --renderer --require ts-node/register src/database/*.test.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.2.5",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@tiptap/extension-image": "^2.12.0",
    "@tiptap/extension-placeholder": "^2.12.0",
    "@tiptap/pm": "^2.12.0",
    "@tiptap/react": "^2.12.0",
    "@tiptap/starter-kit": "^2.12.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mic": "^2.1.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "ollama": "^0.5.16",
    "react-calendar": "^6.0.0",
    "react-circular-progressbar": "^2.2.0",
    "react-live-clock": "^6.1.25",
    "react-moment": "^1.1.3",
    "react-rnd": "^10.5.2",
    "react-slider": "^2.0.6",
    "react-split": "^2.0.14",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "14.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.0.5",
    "chai": "^5.2.1",
    "concurrently": "^9.2.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "electron-mocha": "^13.1.0",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^3.1.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.4",
    "jest-electron": "^0.1.12",
    "jest-environment-jsdom": "^30.0.4",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.7",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.6"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "engines": {
    "yarn": ">=1.22.0"
  },
  "build": {
    "appId": "com.inkflow.desktop",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/InkFlowLogoWhite.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app needs access to the microphone for transcription."
      }
    },
    "files": [
      "out/main/index.js",
      "out/preload/index.js",
      "out/renderer/",
      "package.json"
    ]
  }
}
